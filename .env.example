# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Supabase → Settings → Database → Connection string.
#
# COPY THESE VERBATIM FROM THE DASHBOARD — do not hand-build them from this
# template. The direct and pooled connections use different hosts, and the
# region segment varies per project. The shapes below are illustrative only:
#
#   Transaction pooler (app):   ...pooler.supabase.com:6543/postgres
#   Direct (migrations):        ...db.<project-ref>.supabase.co:5432/postgres
#
# Render holds containers open, so either works for the app; the pooler is the
# safer default under restarts. Migrations should use the direct connection —
# transaction pooling does not support every DDL statement.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Public and safe to expose. Present for storage reads only; the browser never
# talks to Supabase directly in this design (SPEC §3.1), so the frontend needs
# no key at all.
SUPABASE_URL=https://shchnfsyuwofafvlieuo.supabase.co

# NOT NEEDED unless we later use Supabase Storage or its client library.
# It bypasses row-level security entirely — if you add it, it lives here and in
# Render's environment, nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=

# Step 5 (extraction). Not required before then.
# ANTHROPIC_API_KEY=

# Set by Render automatically; 8000 locally.
PORT=8000
