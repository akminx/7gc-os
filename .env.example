# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Database ─────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string.
#
# USE THE POOLER, NOT THE DIRECT CONNECTION.
# Supabase dropped IPv4 for direct connections: db.<ref>.supabase.co now
# resolves to an AAAA record only. Any network without IPv6 egress — including
# most laptops and some hosts — cannot reach it at all. The pooler is IPv4.
#
# You have the right string when the username reads postgres.<project-ref>
# rather than bare postgres.
#
#   MIGRATION_DATABASE_URL  Session pooler, port 5432
#                           Full DDL + prepared statements. Migrations need both.
#   DATABASE_URL            Transaction pooler, port 6543
#                           Best for a long-lived app connection.
MIGRATION_DATABASE_URL=
DATABASE_URL=

# Public and safe to expose. The browser never talks to Supabase directly in
# this design (SPEC §3.1) — it talks to FastAPI — so the frontend needs no key.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed if we add Supabase Storage. Bypasses row-level security entirely;
# if set, it lives here and in Render's environment, nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Models ───────────────────────────────────────────────────────────────
# OpenRouter — one key, OpenAI-compatible API, many providers behind it.
# This makes the SPEC §11 model bake-off cheap: the same request shape scores
# every candidate on the gold set, so model choice becomes a measured decision
# rather than a branded one.
#
# Extraction runs at Step 5 and is cached by document content hash, so a strong
# model touches each document exactly once. Not required before then.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# There is no LLM_REPLAY_ONLY switch, and this file advertised one. Replay is
# the only path `evidence/extract.py` takes: a live call happens when, and only
# when, `--record` is passed explicitly. A flag that has to be SET to stay safe
# is a flag someone forgets; making the live call require an argument means the
# default is the safe one and no configuration can change that.
#
# The fixture is keyed by document content hash AND model id, so changing
# either invalidates the recording rather than replaying a different model's
# answer under the new name.

# ── Runtime ──────────────────────────────────────────────────────────────
# Render sets PORT automatically; 8000 locally.
PORT=8000

# Which schema the API reads. Defaults to `public` when unset.
LEDGER_SCHEMA=demo

# ── Who may record a decision ────────────────────────────────────────────
# SPEC §3.1 · a comma-separated list of actor ids. UNSET is the public,
# read-only posture: `api/decisions.py` refuses every write with 403 and the
# frontend renders no approval control, so the deployment is read-only as a
# property of its configuration rather than of a second build.
#
# Set it and the strongest three seconds in the demo become reachable: trying to
# approve Anthropic's $8,000,000 valuation is refused by a POSTGRES CONSTRAINT
# (`0003_approval_prerequisites.sql`), not by a form check, and the refusal names
# the invariant and the requirement that is short.
#
# THE FRONTEND HAS ITS OWN COPY AND THE TWO MUST MATCH. The browser lists actors
# from `VITE_DECISION_ACTORS` and sends the chosen one as `X-Actor-Id`; this is
# what the API checks it against. Set one and not the other and every decision
# comes back 403 — which looks exactly like the constraint doing its job, and is
# the one failure that would spoil the moment it exists to show.
#
# `VITE_` variables are baked in at BUILD time, so changing the frontend's copy
# is a rebuild rather than a restart.
DECISION_ACTORS=
VITE_DECISION_ACTORS=

# Where the browser sends its requests. Unset, `web/src/data.ts` falls back to
# the bundled one-holding fixture and every screen says so — a misconfigured
# deploy therefore looks like a working app showing the wrong fund, which is why
# the source badge is on every surface.
VITE_API_BASE_URL=
