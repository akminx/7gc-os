# Copy to .env and fill in. .env is gitignored and must never be committed.

# ── Database ─────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string.
#
# USE THE POOLER, NOT THE DIRECT CONNECTION.
# Supabase dropped IPv4 for direct connections: db.<ref>.supabase.co now
# resolves to an AAAA record only. Any network without IPv6 egress — including
# most laptops and some hosts — cannot reach it at all. The pooler is IPv4.
#
# You have the right string when the username reads postgres.<project-ref>
# rather than bare postgres.
#
#   MIGRATION_DATABASE_URL  Session pooler, port 5432
#                           Full DDL + prepared statements. Migrations need both.
#   DATABASE_URL            Transaction pooler, port 6543
#                           Best for a long-lived app connection.
MIGRATION_DATABASE_URL=
DATABASE_URL=

# Public and safe to expose. The browser never talks to Supabase directly in
# this design (SPEC §3.1) — it talks to FastAPI — so the frontend needs no key.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed if we add Supabase Storage. Bypasses row-level security entirely;
# if set, it lives here and in Render's environment, nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Models ───────────────────────────────────────────────────────────────
# OpenRouter — one key, OpenAI-compatible API, many providers behind it.
# This makes the SPEC §11 model bake-off cheap: the same request shape scores
# every candidate on the gold set, so model choice becomes a measured decision
# rather than a branded one.
#
# Extraction runs at Step 5 and is cached by document content hash, so a strong
# model touches each document exactly once. Not required before then.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fixtures are replayed in tests and the eval harness, so CI never calls a live
# model (SPEC §11). Set to 1 to force replay-only locally.
LLM_REPLAY_ONLY=0

# ── Runtime ──────────────────────────────────────────────────────────────
# Render sets PORT automatically; 8000 locally.
PORT=8000

# Which schema the API reads. Defaults to `public` when unset.
LEDGER_SCHEMA=demo
